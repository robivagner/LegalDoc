@page "/settings"

@using LegalDoc.Web.Auth
@using LegalDoc.Web.Models
@using LegalDoc.Web.Services
@inject AuthService AuthSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager NavManager

<MudContainer MaxWidth="MaxWidth.Large" Class="pt-8 mt-4">
    <AuthorizeView>
        <Authorized>
            <div class="mb-8">
                <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 800">Setări</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Gestionează securitatea contului tău și administrarea utilizatorilor.</MudText>
            </div>

            <MudTabs Outlined="true" Position="Position.Top" Rounded="true" Border="true" ApplyEffectsToContainer="true" ContentClass="pa-6" Color="Color.Primary">
                
                @* --- TAB SECURITATE --- *@
                <MudTabPanel Text="Securitate Cont" Icon="@Icons.Material.Filled.Security">
                    <MudGrid Justify="Justify.Center">
                        <MudItem xs="12" md="7">
                            @* Am adăugat MudStack cu Spacing="6" și py-4 pentru spațiu între carduri și margini *@
                            <MudStack Spacing="6" Class="py-4">
                                
                                @* Card Actualizare Username *@
                                <MudCard Elevation="4" Class="border-l-4 mud-border-primary">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.h6">Actualizare Username</MudText>
                                            <MudText Typo="Typo.caption">Alege un nume de utilizator nou pentru identificare.</MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudTextField @bind-Value="_newUsername" 
                                                     Label="Username Nou" 
                                                     Variant="Variant.Outlined" 
                                                     Adornment="Adornment.Start" 
                                                     AdornmentIcon="@Icons.Material.Filled.Person" 
                                                     Margin="Margin.Normal" />
                                    </MudCardContent>
                                    <MudCardActions>
                                        <MudButton Variant="Variant.Filled" 
                                                   Color="Color.Primary" 
                                                   OnClick="HandleChangeUsername" 
                                                   Disabled="_loadingUsername"
                                                   Class="ml-auto">
                                            @if (_loadingUsername) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/> }
                                            Actualizează Username
                                        </MudButton>
                                    </MudCardActions>
                                </MudCard>

                                @* Card Schimbare Parolă *@
                                <MudCard Elevation="4" Class="border-l-4 mud-border-secondary">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.h6">Schimbare Parolă</MudText>
                                            <MudText Typo="Typo.caption">Asigură-te că folosești o parolă puternică.</MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudStack Spacing="3">
                                            <MudTextField @bind-Value="_currentPassword" 
                                                         Label="Parola Curentă" 
                                                         InputType="InputType.Password" 
                                                         Variant="Variant.Outlined" />
                                            <MudTextField @bind-Value="_newPassword" 
                                                         Label="Parola Nouă" 
                                                         InputType="InputType.Password" 
                                                         Variant="Variant.Outlined" />
                                        </MudStack>
                                    </MudCardContent>
                                    <MudCardActions>
                                        <MudButton Variant="Variant.Filled" 
                                                   Color="Color.Secondary" 
                                                   OnClick="HandleChangePassword" 
                                                   Disabled="_loadingPassword"
                                                   Class="ml-auto">
                                            @if (_loadingPassword) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/> }
                                            Schimbă Parola
                                        </MudButton>
                                    </MudCardActions>
                                </MudCard>

                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                @* --- TAB ADMIN --- *@
                <AuthorizeView Roles="Admin" Context="adminContext">
                    <Authorized>
                        <MudTabPanel Text="Administrare Utilizatori" Icon="@Icons.Material.Filled.AdminPanelSettings">
                            <MudPaper Elevation="0" Class="pa-2">
                                <div class="d-flex align-center mb-4">
                                    <MudText Typo="Typo.h6" Color="Color.Primary">Listă Utilizatori Sistem</MudText>
                                    <MudSpacer />
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" 
                                                   Color="Color.Primary" 
                                                   OnClick="LoadUsers" 
                                                   Disabled="_loadingUsers" />
                                </div>
                                
                                <MudTable Items="_allUsers" 
                                          Hover="true" 
                                          Striped="false" 
                                          Elevation="2" 
                                          Loading="_loadingUsers" 
                                          Breakpoint="Breakpoint.Sm"
                                          Class="border-solid border-2 mud-border-primary">
                                    <HeaderContent>
                                        <MudTh>Username</MudTh>
                                        <MudTh>Rol Actual</MudTh>
                                        <MudTh Style="text-align: right">Acțiuni</MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="user">
                                        <MudTd DataLabel="Username">
                                            <div class="d-flex align-center">
                                                <MudAvatar Color="Color.Info" Size="Size.Small" Class="mr-3">@user.UserName[0].ToString().ToUpper()</MudAvatar>
                                                @user.UserName
                                            </div>
                                        </MudTd>
                                        <MudTd DataLabel="Rol">
                                            <MudChip T="string" 
                                                     Variant="Variant.Filled"
                                                     Color="@(user.Role == "Admin" ? Color.Error : user.Role == "Lawyer" ? Color.Primary : Color.Default)" 
                                                     Size="Size.Small">
                                                @user.Role
                                            </MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Acțiuni" Style="text-align: right">
                                            @if (user.Role == "Viewer")
                                            {
                                                <MudButton Variant="Variant.Outlined" 
                                                           Color="Color.Primary" 
                                                           Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.Security" 
                                                           OnClick="@(() => ChangeUserRole(user.Id, "Lawyer"))">
                                                    Promovează
                                                </MudButton>
                                            }
                                            else if (user.Role == "Lawyer")
                                            {
                                                <MudButton Variant="Variant.Outlined" 
                                                           Color="Color.Warning" 
                                                           Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.Person" 
                                                           OnClick="@(() => ChangeUserRole(user.Id, "Viewer"))">
                                                    Retrogradează
                                                </MudButton>
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                    <NoRecordsContent>
                                        <MudText>Nu au fost găsiți utilizatori.</MudText>
                                    </NoRecordsContent>
                                </MudTable>
                            </MudPaper>
                        </MudTabPanel>
                    </Authorized>
                </AuthorizeView>

            </MudTabs>
        </Authorized>

        <NotAuthorized>
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 text-center">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Error" Class="mb-4" />
                <MudText Typo="Typo.h5" GutterBottom="true">Acces Restricționat</MudText>
                <MudText Typo="Typo.body1" Class="mb-6">Trebuie să fii autentificat pentru a accesa această pagină.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => NavManager.NavigateTo("/login"))">Loghează-te</MudButton>
            </MudContainer>
        </NotAuthorized>
    </AuthorizeView>
</MudContainer>

@code {
    private string _newUsername = "";
    private string _currentPassword = "";
    private string _newPassword = "";
    private bool _loadingUsername;
    private bool _loadingPassword;

    private List<UserDto> _allUsers = new();
    private bool _loadingUsers;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.IsInRole("Admin"))
        {
            await LoadUsers();
        }
    }

    private async Task HandleChangeUsername()
    {
        if (string.IsNullOrWhiteSpace(_newUsername)) return;
        _loadingUsername = true;

        var result = await AuthSvc.ChangeUsernameAsync(_newUsername);
    
        if (result != null)
        {
            ((CustomAuthStateProvider)AuthStateProvider).NotifyUserLogin(result.UserName);

            Snackbar.Add("Username actualizat cu succes!", Severity.Success);
            _newUsername = "";
        }
        else 
        {
            Snackbar.Add("Eroare la schimbarea numelui de utilizator.", Severity.Error);
        }
        _loadingUsername = false;
    }

    private async Task HandleChangePassword()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword)) return;
        _loadingPassword = true;
        var result = await AuthSvc.ChangePasswordAsync(_currentPassword, _newPassword);
        if (result.Succeeded) 
        {
            Snackbar.Add("Parola a fost schimbată cu succes!", Severity.Success);
            _currentPassword = _newPassword = "";
        }
        else 
            Snackbar.Add(result.Error ?? "Eroare la schimbarea parolei", Severity.Error);
        _loadingPassword = false;
    }

    private async Task LoadUsers()
    {
        try
        {
            _loadingUsers = true;
            _allUsers = await AuthSvc.GetAllUsersAsync();
        }
        catch (Exception)
        {
            Snackbar.Add("Eroare la încărcarea utilizatorilor.", Severity.Error);
        }
        finally
        {
            _loadingUsers = false;
        }
    }

    private async Task ChangeUserRole(string userId, string newRole)
    {
        var result = await AuthSvc.UpdateUserRoleAsync(userId, newRole);
        if (result.Succeeded) 
        {
            Snackbar.Add("Rol actualizat cu succes!", Severity.Success);
            await LoadUsers();
        }
        else
        {
            Snackbar.Add(result.Error ?? "Eroare la actualizarea rolului", Severity.Error);
        }
    }
}