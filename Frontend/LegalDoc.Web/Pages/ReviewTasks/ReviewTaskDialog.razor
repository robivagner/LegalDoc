@using LegalDoc.Web.Models

<MudDialog>
    <DialogContent>
        <div style="max-height: 65vh; overflow-y: auto; padding-right: 16px;">
            <MudText Typo="Typo.h6" Class="mb-4">Document: <strong>@Document.Title</strong></MudText>

            @* Verificăm dacă documentul are vreun rezultat AI *@
            @if (string.IsNullOrWhiteSpace(Document.Summary) && string.IsNullOrWhiteSpace(Document.Clauses) && string.IsNullOrWhiteSpace(Document.Risks))
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    Acest document nu conține încă o analiză AI finalizată.
                </MudAlert>
            }
            else
            {
                @* 1. REZUMAT *@
                @if (!string.IsNullOrWhiteSpace(Document.Summary))
                {
                    <MudPaper Elevation="0" Class="pa-4 mb-4 mud-background-gray">
                        <div class="d-flex align-center mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Secondary" Class="mr-2" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Rezumat Generat de AI</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Document.Summary</MudText>
                    </MudPaper>
                }

                @* 2. CLAUZE IMPORTANTE *@
                @if (!string.IsNullOrWhiteSpace(Document.Clauses))
                {
                    <MudPaper Elevation="0" Class="pa-4 mb-4 mud-background-gray">
                        <div class="d-flex align-center mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Info" Class="mr-2" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Clauze Importante</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Document.Clauses</MudText>
                    </MudPaper>
                }

                @* 3. RISCURI *@
                @if (!string.IsNullOrWhiteSpace(Document.Risks))
                {
                    <MudPaper Elevation="0" Class="pa-4 mb-4 mud-background-gray">
                        <div class="d-flex align-center mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="mr-2" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Riscuri Identificate</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Document.Risks</MudText>
                    </MudPaper>
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">Anulează</MudButton>
        <MudSpacer />
        <MudButton Color="Color.Error" 
                   Variant="Variant.Filled" 
                   StartIcon="@Icons.Material.Filled.Close" 
                   OnClick="@(() => Submit("Rejected"))">
            Respinge
        </MudButton>
        <MudButton Color="Color.Success" 
                   Variant="Variant.Filled" 
                   StartIcon="@Icons.Material.Filled.Check" 
                   OnClick="@(() => Submit("Completed"))">
            Aprobă
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public DocumentDto Document { get; set; } = null!;
    [Parameter] public ReviewTaskDto Task { get; set; } = null!;

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Submit(string resultStatus)
    {
        // Returnăm statusul ales (Completed sau Rejected) înapoi către pagina principală
        MudDialog.Close(DialogResult.Ok(resultStatus));
    }
}