@using LegalDoc.Web.Models
@using LegalDoc.Web.Services
@using MudBlazor
@inject ReviewTaskService TaskSvc
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudSelect T="Guid" 
                       Label="Selectează Noul Avocat" 
                       @bind-Value="_selectedLawyerId" 
                       Required="true" 
                       RequiredError="Trebuie să selectezi un avocat!">
                @* Filtrăm avocații: să fie activi și să NU fie avocatul curent *@
                @foreach (var lawyer in Lawyers.Where(l => l.IsActive && l.Id != CurrentLawyerId))
                {
                    <MudSelectItem Value="@lawyer.Id">@lawyer.Name</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Anulează</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Submit" 
                   Disabled="@(!_isValid)">
            Reasignează
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    // Parametri primiți de la pagina părinte (Tasks.razor)
    [Parameter] public Guid TaskId { get; set; }
    [Parameter] public Guid CurrentLawyerId { get; set; }
    [Parameter] public List<LawyerDto> Lawyers { get; set; } = new();

    private MudForm _form = null!;
    private bool _isValid;
    private Guid _selectedLawyerId;

    private async Task Submit()
    {
        await _form.Validate();
        
        if (_form.IsValid)
        {
            try
            {
                await TaskSvc.ReassignTaskAsync(TaskId, _selectedLawyerId);
                Snackbar.Add("Task-ul a fost reasignat cu succes!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Snackbar.Add("Eroare la reasignare: " + ex.Message, Severity.Error);
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}