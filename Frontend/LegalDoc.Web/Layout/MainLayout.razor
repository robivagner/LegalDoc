@inherits LayoutComponentBase
@using LegalDoc.Web.Auth
@inject State.AppState AppState
@inject Services.DocumentService DocService
@inject Services.ReviewTaskService TaskService
@inject Services.LawyerService LawyerService
@inject Services.AuthService AuthService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<MudThemeProvider IsDarkMode="@_isDarkMode" Theme="_currentTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        
        <a href="/" class="d-flex align-center" style="text-decoration: none; color: inherit; cursor: pointer;">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="mr-2 ml-4" />
            <MudText Typo="Typo.h5" Style="font-weight: 800; letter-spacing: 1px;">LegalDoc</MudText>
            <MudText Typo="Typo.h5" Color="Color.Secondary" Style="font-weight: 800; margin-left: 4px;">AI</MudText>
        </a>
        
        <MudSpacer />
        
        @* Notificări protejate de statusul de login *@
        <AuthorizeView>
            <Authorized>
                <MudTooltip Text="@(AppState.NeedsProfileCompletion ? "Finalizează profilul" : "Analize AI")">
                    <MudBadge Content="@AppState.PendingAiAnalysesCount" Color="Color.Secondary" Overlap="true" Visible="@(AppState.PendingAiAnalysesCount > 0)">
                        <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome" 
                                       Color="Color.Inherit" 
                                       href="/documents" 
                                       Disabled="@AppState.NeedsProfileCompletion" />
                    </MudBadge>
                </MudTooltip>
                
                <MudTooltip Text="@(AppState.NeedsProfileCompletion ? "Finalizează profilul" : "Sarcinile mele")">
                    <MudBadge Content="@AppState.PendingTasksCount" Color="Color.Error" Overlap="true" Visible="@(AppState.PendingTasksCount > 0)">
                        <MudIconButton Icon="@Icons.Material.Filled.Notifications" 
                                       Color="Color.Inherit" 
                                       href="/tasks" 
                                       Disabled="@AppState.NeedsProfileCompletion" />
                    </MudBadge>
                </MudTooltip>
            </Authorized>
        </AuthorizeView>

        <MudTooltip Text="@(_isDarkMode ? "Treci la tema luminoasă" : "Treci la tema întunecată")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                           Color="Color.Inherit" 
                           OnClick="ToggleDarkMode" />
        </MudTooltip>
        
        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudButton StartIcon="@Icons.Material.Filled.PersonAdd" Color="Color.Warning" Variant="Variant.Text" Href="/admin/register" Class="ml-4">
                    Creare Cont
                </MudButton>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                @{
                    var userName = context.User.Identity?.Name;
                    var userRole = context.User.FindFirst("role")?.Value ?? "Viewer";
                    var roleColor = userRole == "Admin" ? Color.Warning : userRole == "Lawyer" ? Color.Info : Color.Tertiary;
                }
                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Icon="@Icons.Material.Filled.Person" Class="ml-2">@userName</MudChip>
                <MudChip T="string" Color="@roleColor" Size="Size.Small" Variant="Variant.Filled" Class="ml-1 mr-2">@userRole</MudChip>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" />
            </Authorized>
            <NotAuthorized>
                <MudButton StartIcon="@Icons.Material.Filled.Login" Color="Color.Secondary" Variant="Variant.Filled" Href="/login" Class="ml-4">Login</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pb-8">
            <AuthorizeView>
                <Authorized>
                    @* Doar utilizatorii logați văd conținutul paginilor *@
                    <CascadingValue Value="this">
                        @Body
                    </CascadingValue>
                </Authorized>
                <NotAuthorized>
                    @* Utilizatorii nelogați văd doar paginile de login sau un mesaj de eroare *@
                    @if (NavManager.Uri.Contains("/login"))
                    {
                        @Body
                    }
                    else
                    {
                        <div class="d-flex flex-column align-center justify-center mt-16">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Error" />
                            <MudText Typo="Typo.h5" Class="mt-4">Acces restricționat. Te rugăm să te autentifici.</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" href="/login" Class="mt-4">Spre Login</MudButton>
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    public bool _isDarkMode { get; set; } = false;
    private MudTheme _currentTheme = new MudTheme();

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await CheckAndLoadData();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(async () => {
            await CheckAndLoadData();
            StateHasChanged();
        });
    }

    private async Task CheckAndLoadData()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            Guid? currentLawyerId = null;
            if (user.IsInRole("Lawyer"))
            {
                var profile = await LawyerService.GetMyProfileAsync();
                AppState.UpdateProfileStatus(profile == null);
                currentLawyerId = profile?.Id;
            }
            else
            {
                AppState.UpdateProfileStatus(false);
            }
            await LoadInitialNotificationCounts(currentLawyerId);
        }
        else
        {
            ResetGlobalState();
        }
    }

    private void ResetGlobalState()
    {
        AppState.UpdateProfileStatus(false);
        AppState.UpdatePendingAiAnalyses(0);
        AppState.UpdatePendingTasks(0);
    }

    private async Task LoadInitialNotificationCounts(Guid? lawyerId)
    {
        try
        {
            var uploadedDocsTask = DocService.GetDocumentsByStatusAsync("Uploaded");
            var rejectedDocsTask = DocService.GetDocumentsByStatusAsync("Rejected");
            var pendingTasksTask = TaskService.GetTasksFilteredAsync(lawyerId, "Created");
            
            await Task.WhenAll(uploadedDocsTask, rejectedDocsTask, pendingTasksTask);
            
            AppState.UpdatePendingAiAnalyses(uploadedDocsTask.Result.Count + rejectedDocsTask.Result.Count);
            AppState.UpdatePendingTasks(pendingTasksTask.Result.Count);
        }
        catch { }
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    void DrawerToggle() => _drawerOpen = !_drawerOpen;
    
    public async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "darkMode", _isDarkMode.ToString().ToLower());
        StateHasChanged();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var darkModeStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "darkMode");
            if (bool.TryParse(darkModeStored, out bool isDark))
            {
                _isDarkMode = isDark;
                StateHasChanged();
            }
        }
    }
    
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        ((CustomAuthStateProvider)AuthProvider).NotifyUserLogout();
        ResetGlobalState();
        NavManager.NavigateTo("/login");
    }
}