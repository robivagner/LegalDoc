@page "/"

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h3" GutterBottom="true" Style="font-weight: 800" Color="Color.Primary">
        Bun venit în LegalDoc AI
    </MudText>
    <MudText Typo="Typo.body1" Class="mb-8" Style="font-size: 1.1rem; color: var(--mud-palette-text-secondary);">
        Sistem inteligent de analiză și arhivare a documentelor juridice.
    </MudText>

    @* Folosim un Spacing mai mare între rânduri pentru aerisire *@
    <MudGrid Spacing="4">
        
        @* --- RANDUL 1 --- *@
        <MudItem xs="12" sm="6" md="6">
            <MudPaper Class="pa-6" Elevation="3" Style="height: 100%; display: flex; flex-direction: column;">
                <div class="d-flex align-center mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" Class="mr-3" />
                    <MudText Typo="Typo.h6">Documente</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="flex-grow-1 mb-4">Gestionează arhiva centralizată de contracte și documente juridice.</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" href="/documents" FullWidth="true">Vezi Arhiva</MudButton>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="6">
            <MudPaper Class="pa-6" Elevation="3" Style="height: 100%; display: flex; flex-direction: column;">
                <div class="d-flex align-center mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" Class="mr-3" />
                    <MudText Typo="Typo.h6">Registre</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="flex-grow-1 mb-4">Administrează registrele și categoriile în care sunt organizate documentele.</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" href="/registries" FullWidth="true">Gestionare Registre</MudButton>
            </MudPaper>
        </MudItem>

        @* --- RANDUL 2 --- *@
        <MudItem xs="12" sm="6" md="6">
            <MudPaper Class="pa-6" Elevation="3" Style="height: 100%; display: flex; flex-direction: column;">
                <div class="d-flex align-center mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Secondary" Class="mr-3" />
                    <MudText Typo="Typo.h6">Avocați</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="flex-grow-1 mb-4">Vizualizează și gestionează directorul de avocați alocați cazurilor.</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" href="/lawyers" FullWidth="true">Vezi Director</MudButton>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="6">
            <MudPaper Class="pa-6" Elevation="3" Style="height: 100%; display: flex; flex-direction: column;">
                <div class="d-flex align-center mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Info" Class="mr-3" />
                    <MudText Typo="Typo.h6">Sarcini Review</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="flex-grow-1 mb-4">Verifică stadiul analizelor umane și sarcinile de aprobare în așteptare.</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" href="/tasks" FullWidth="true">Vezi Sarcini</MudButton>
            </MudPaper>
        </MudItem>

    </MudGrid>
</MudContainer>