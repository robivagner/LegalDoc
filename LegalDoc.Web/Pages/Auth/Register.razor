@page "/admin/register"
@using LegalDoc.Web.Models
@using LegalDoc.Web.Services
@attribute [Authorize(Roles = "Admin")]
@inject AuthService AuthSvc
@inject ISnackbar Snackbar
@inject NavigationManager NavManager

<MudContainer MaxWidth="MaxWidth.Small" Class="pt-16">
    <MudPaper Elevation="4" Class="pa-8">
        <MudStack Spacing="4">
            <div class="text-center">
                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Class="mt-2">Creare Utilizator</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Contul va fi creat implicit cu rolul de <b>Viewer</b>.
                </MudText>
            </div>

            <MudForm @ref="_form" @bind-IsValid="@_success">
                <MudTextField T="string" Label="Nume Utilizator (Username)" 
                              @bind-Value="_model.UserName" 
                              Required="true" 
                              Variant="Variant.Outlined"
                              Class="mt-4" />

                <MudTextField T="string" Label="Parolă Temporară" 
                              @bind-Value="_model.Password" 
                              Required="true" 
                              InputType="@_passwordInput"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordInputIcon"
                              OnAdornmentClick="TogglePasswordVisibility"
                              Class="mt-2" />
            </MudForm>

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       Size="Size.Large" 
                       FullWidth 
                       OnClick="HandleRegister"
                       Disabled="@(_loading || !_success)"
                       Class="mt-4">
                @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
                else { <MudText>Creează Cont</MudText> }
            </MudButton>
            
            <MudButton Variant="Variant.Text" 
                       Color="Color.Default" 
                       FullWidth 
                       OnClick="@(() => NavManager.NavigateTo("/"))">
                Home
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form = null!;
    private bool _success;
    private bool _loading;
    private RegisterRequest _model = new();

    private bool _passwordVisible;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        if (_passwordVisible)
        {
            _passwordVisible = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInput = InputType.Password;
        }
        else
        {
            _passwordVisible = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInput = InputType.Text;
        }
    }

    private async Task HandleRegister()
    {
        _loading = true;
        var result = await AuthSvc.RegisterUserAsync(_model.UserName, _model.Password);

        if (result.Succeeded)
        {
            Snackbar.Add($"Utilizatorul {_model.UserName} a fost creat!", Severity.Success);
            NavManager.NavigateTo("/");
        }
        else
        {
            Snackbar.Add($"Eroare: {result.Error}", Severity.Error);
        }
        _loading = false;
    }
}