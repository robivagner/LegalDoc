@inject State.AppState AppState
@implements IDisposable

<MudNavMenu>
    @* --- SECTIUNE ONBOARDING --- *@
    @if (AppState.NeedsProfileCompletion)
    {
        <div class="pa-4">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mud-width-full">
                Profil Incomplet
            </MudAlert>
        </div>
        <MudNavLink href="/complete-profile" 
                    Icon="@Icons.Material.Filled.AssignmentInd" 
                    IconColor="Color.Warning" 
                    Style="font-weight: 900; color: #ff9800 !important; background-color: rgba(255, 152, 0, 0.1); border-radius: 4px;">
            COMPLETE LAWYER PROFILE
        </MudNavLink>
        <MudDivider Class="my-2" />
    }

    @* Management - Adaugă Disabled pe fiecare link *@
    <div class="pa-4">
        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">MANAGEMENT</MudText>
    </div>
    <MudNavLink Match="NavLinkMatch.All" href="/" Icon="@Icons.Material.Filled.Dashboard" Disabled="@AppState.NeedsProfileCompletion">Dashboard</MudNavLink>
    <MudNavLink href="/documents" Icon="@Icons.Material.Filled.Description" Disabled="@AppState.NeedsProfileCompletion">Documents Archive</MudNavLink>
    <MudNavLink href="/registries" Icon="@Icons.Material.Filled.AccountBalance" Disabled="@AppState.NeedsProfileCompletion">Registries</MudNavLink>
    
    <MudDivider Class="my-2" />
    
    @* Legal Team - Adaugă Disabled *@
    <div class="pa-4">
        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">LEGAL TEAM</MudText>
    </div>
    <MudNavLink href="/lawyers" Icon="@Icons.Material.Filled.Gavel" Disabled="@AppState.NeedsProfileCompletion">Lawyers Directory</MudNavLink>
    <MudNavLink href="/tasks" Icon="@Icons.Material.Filled.Assignment" Disabled="@AppState.NeedsProfileCompletion">Review Tasks</MudNavLink>
    
    <MudDivider Class="my-2" />
    
    <MudNavLink href="/settings" Icon="@Icons.Material.Filled.Settings" Disabled="@AppState.NeedsProfileCompletion">Account Settings</MudNavLink>
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}